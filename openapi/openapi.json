          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password", "email"],
                "properties": {
                  "username": {
                    "maxLength": 50,
                    "type": "string"
                  },
                  "password": {
                    "maxLength": 255,
